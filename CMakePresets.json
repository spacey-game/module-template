{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Configure the project with the default library build and tests enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests",
      "description": "Configure the project with tests enabled for ctest.",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/tests",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Configure the project with coverage instrumentation enabled.",
      "inherits": "tests",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "targets": [
        "engine_module_coverage"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
